{
  "name": "HiveVM Website",
  "image": "mcr.microsoft.com/devcontainers/base:debian",

  "remoteUser": "vscode",
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    // Podman 5.8 builds reset /tmp to 0755 when a Feature is installed: a RUN --mount below /tmp that
    // also writes to /tmp commits the directory with the wrong mode. VS Code then cannot create
    // /tmp/.X11-unix as the remote user and connecting fails. Features and Dockerfiles cannot repair
    // this at build time, so restore the world-writable sticky /tmp at run time.
    "type=tmpfs,target=/tmp,tmpfs-mode=1777"
  ],

  // Runs on the host before the container is created. Ensures the bind-mount source for the agent
  // config exists, so Docker does not auto-create it as a root-owned directory (which breaks
  // credential writes inside the container).
  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude",

  "features": {
    // GitHub CLI (`gh`) for GitHub operations. Every git write through it needs the human's
    // go-ahead (AGENTS.md, section 4).
    "ghcr.io/devcontainers/features/github-cli:1": {},
    // Hugo (extended) for local previews (ADR-0005). Keep the version in sync with HUGO_VERSION in
    // .github/workflows/hugo.yml so the preview matches the deployed build.
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "0.167.0",
      "extended": true
    }
  },

  // Forward the `hugo server` preview port to the host.
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": {
      "label": "Hugo preview"
    }
  },

  "customizations": {
    // VS Code extensions installed inside the container
    "vscode": {
      "extensions": [
        "anthropic.claude-code"
      ]
    }
  }
}
